{
  "expo": {
    "name": "HandScript",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "scheme": "handscript",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roey.handscript",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "HandScript משתמש במצלמה כדי לצלם את כתב היד שלך וליצור פונט אישי.",
        "NSPhotoLibraryAddUsageDescription": "HandScript שומר את הדפים שיצרת כתמונות בגלריה כדי שתוכלו לשתף בקלות.",
        "NSPhotoLibraryUsageDescription": "HandScript טוען תמונות של דפי כתב יד מהגלריה כדי לאמן את הפונט האישי, ושומר את הדפים שהפכת לכתב יד.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.roey.handscript",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-build-properties", {
        "android": {
          "enableDeveloperMode": false,
          "minifyEnabled": true,
          "usesCleartextTraffic": false
        },
        "ios": {
          "deploymentTarget": "15.1"
        }
      }],
      [
        "expo-camera",
        {
          "cameraPermission": "HandScript משתמש במצלמה כדי לצלם את כתב היד שלך וליצור ממנו פונט אישי."
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "HandScript שומרת את דפי כתב היד שלך לגלריה כדי שתוכל לשתף אותם בקלות.",
          "savePhotosPermission": "HandScript שומרת את דפי כתב היד שלך לגלריה כדי שתוכל לשתף אותם בקלות.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "28b061a5-77c0-4634-871b-f9e473e9ba81"
      },
      "BACKEND_URL": "https://api.handscript.co.il"
    }
  }
}
