# ── Environment ──────────────────────────────────────────────────────────────
# Set to "development" to bypass Firebase token verification (local dev only!)
# NEVER set this to "development" in production.
APP_ENV=production

# Set to "true" to skip auth entirely (dev-only shortcut, implies APP_ENV=development)
# SKIP_AUTH=false

# ── Firebase Admin SDK credentials ───────────────────────────────────────────
# Option A (Railway / CI): paste the full serviceAccountKey.json as single-line JSON
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Option B (local dev): path to the serviceAccountKey.json file
FIREBASE_KEY_PATH=./serviceAccountKey.json

# Firebase Storage bucket (without gs:// prefix)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ── Google Vision API ─────────────────────────────────────────────────────────
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# ── CORS extra origins ────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins (e.g. production domain)
# ALLOWED_ORIGINS=https://app.handscript.co.il

# ── Firebase Web API key (auth REST proxy) ────────────────────────────────────
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ── Custom transactional email (Gmail SMTP) ───────────────────────────────────
# Sends the designed verification / password-reset emails. The backend
# generates the action link via the Admin SDK and delivers our own HTML
# template. Leave SMTP_* empty to fall back to Firebase's default email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls            # "starttls" (port 587) or "ssl" (port 465)
SMTP_USERNAME=handscript3@gmail.com
# 16-character Gmail App Password (NOT the account password). Create one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_PASSWORD=gmatamiharufwnkn
SMTP_FROM=handscript3@gmail.com   # must match SMTP_USERNAME for Gmail
SMTP_FROM_NAME=HandScript
